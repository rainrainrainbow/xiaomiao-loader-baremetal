# ===== WiFi OTA 额外配置 =====
# 与 sdkconfig.defaults 配合使用（SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.wifi"）
# 该文件由 CI WiFi job 使用，也可本地手动编译 WiFi 版：
#   export SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.wifi"
#   idf.py build

# 启用 WiFi OTA 功能
CONFIG_XIAOMIAO_ENABLE_WIFI=y

# 使用更大的 factory 分区（WiFi 版 app ~673KB 超出原 568KB）
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_wifi.csv"

# ── 激进的体积优化 ────────────────────────────────────────
# 目标：WiFi 版 app ≤ 300KB，装进 568KB 工厂分区
# 注意：禁用项必须用 "# CONFIG_XXX is not set" 格式

# 关闭 mbedtls 非必要的 TLS 部分（保留 TLS1.2 因为 esp_wifi 的 WPA2 依赖 mbedtls TLS，
# 但关闭所有协议会导致 check_config.h 报错 "no protocols are active"）
# CONFIG_MBEDTLS_SSL_PROTO_TLS1_1 is not set
# CONFIG_MBEDTLS_SSL_PROTO_TLS1 is not set
# CONFIG_MBEDTLS_SSL_PROTO_DTLS is not set
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set
# CONFIG_MBEDTLS_HAVE_TIME is not set
# CONFIG_MBEDTLS_HAVE_TIME_DATE is not set
# CONFIG_MBEDTLS_X509_CRT_PARSE_C is not set
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set

# 最小化 lwip
# CONFIG_LWIP_IPV6 is not set
CONFIG_LWIP_MAX_SOCKETS=4
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_TCP_WND=4096
CONFIG_LWIP_TCP_SND_BUF=4096
CONFIG_LWIP_DHCP_MAX_NTP_SERVERS=0
CONFIG_LWIP_DNS_MAX_SERVERS=1
# CONFIG_LWIP_IRAM_OPTIMIZATION is not set
# CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION is not set
# CONFIG_LWIP_LOOPBACK_INTERFACE is not set
# CONFIG_LWIP_SNTP is not set
# CONFIG_LWIP_NETIF_API is not set
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
# CONFIG_LWIP_FRAGMENT_TCP_MSS_OPTION is not set
# CONFIG_LWIP_IP_FRAG is not set
# CONFIG_LWIP_IP_REASSEMBLY is not set
# CONFIG_LWIP_IP_REASS_MAX_PBUFS is not set
# CONFIG_LWIP_TCP_KEEP_CONNECTION_WHEN_IF_DOWN is not set
# CONFIG_LWIP_TCP_OVERSIZE_NONE is not set
# CONFIG_LWIP_TCP_TIMESTAMPS is not set
# CONFIG_LWIP_IGMP is not set
# CONFIG_LWIP_MLD6 is not set
# CONFIG_LWIP_DHCP_DOES_ARP_CHECK is not set
# CONFIG_LWIP_USE_ONLY_LWIP_SELECT is not set
# CONFIG_LWIP_SO_REUSE is not set

# 最小化 WiFi
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# CONFIG_ESP_WIFI_ENHANCED_LIGHT_SLEEP is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_CSI_ENABLED is not set
# CONFIG_ESP_WIFI_PSCAN_ENABLE is not set
# CONFIG_ESP_WIFI_MBEDTLS_TLS_CLIENT is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_NAN_ENABLE is not set
# CONFIG_ESP_WIFI_WAPI_PSK is not set
# CONFIG_ESP_WIFI_SUITE_B_192 is not set
# CONFIG_ESP_WIFI_11KV_SUPPORT is not set
# CONFIG_ESP_WIFI_RRM_SUPPORT is not set
# CONFIG_ESP_WIFI_WNM_SUPPORT is not set
# CONFIG_ESP_WIFI_MBO_SUPPORT is not set
# CONFIG_ESP_WIFI_DPP_SUPPORT is not set
# CONFIG_ESP_WIFI_11R_SUPPORT is not set
# CONFIG_ESP_WIFI_WPS_SOFTAP_REGISTRAR is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_ROAMING_APP is not set
# CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM is not set
# CONFIG_ESP_WIFI_SCAN_CACHE is not set
# CONFIG_ESP_WIFI_DEBUG_PRINT is not set
# CONFIG_ESP_WIFI_ENABLE_WIFI_TX_STATS is not set
# CONFIG_ESP_WIFI_ENABLE_WIFI_RX_STATS is not set
# CONFIG_ESP_WIFI_ENABLE_WIFI_RX_MU_STATS is not set
# CONFIG_ESP_WIFI_ENABLE_DUMP_HESIGB is not set
# CONFIG_ESP_WIFI_ENABLE_DUMP_MU_CFO is not set
# CONFIG_ESP_WIFI_ENABLE_DUMP_CTRL_NDPA is not set
# CONFIG_ESP_WIFI_ENABLE_DUMP_CTRL_BFRP is not set
# CONFIG_ESP_WIFI_SLP_SAMPLE_BEACON_FEATURE is not set
# CONFIG_ESP_WIFI_WPS_STRICT is not set
# CONFIG_ESP_WIFI_WPS_PASSPHRASE is not set
# CONFIG_ESP_WIFI_WPS_RECONNECT_ON_FAIL is not set
# CONFIG_ESP_WIFI_ENT_FREE_DYNAMIC_BUFFER is not set
# CONFIG_ESP_WIFI_EAP_TLS1_3 is not set
# CONFIG_ESP_WIFI_TX_HETB_QUEUE_NUM is not set

# 最小化 wpa_supplicant
# CONFIG_WPA_WAPI_PSK is not set
# CONFIG_WPA_11KV_SUPPORT is not set
# CONFIG_WPA_DPP_SUPPORT is not set
# CONFIG_WPA_SUITEB192 is not set
# CONFIG_WPA_DEBUG_PRINT is not set
# CONFIG_WPA_ENTERPRISE is not set
# CONFIG_WPA_MBO_SUPPORT is not set
# CONFIG_WPA_OWE_STA is not set
# CONFIG_WPA_CTRL_IFACE is not set

# 最小化 nvs_flash
# CONFIG_NVS_ENCRYPTION is not set
# CONFIG_NVS_COMPATIBLE_PRE_V4_3_ENABLE is not set

# 最小化 esp_netif
# CONFIG_ESP_NETIF_LOOPBACK is not set
# CONFIG_ESP_NETIF_BRIDGE_EN is not set

# 最小化其他
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2048
# CONFIG_ESP_PHY_ENABLE_USB is not set
# CONFIG_ESP_PHY_REDUCE_TX_POWER is not set