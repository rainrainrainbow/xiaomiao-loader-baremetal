# ===== WiFi OTA 额外配置 =====
# 与 sdkconfig.defaults 配合使用（SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.wifi"）
# 该文件由 CI WiFi job 使用，也可本地手动编译 WiFi 版：
#   export SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.wifi"
#   idf.py build

# 启用 WiFi OTA 功能
CONFIG_XIAOMIAO_ENABLE_WIFI=y

# ── 激进的体积优化 ────────────────────────────────────────
# 目标：WiFi 版 app ≤ 300KB，装进 568KB 工厂分区
# 注意：所有禁用项必须用 "# CONFIG_XXX is not set" 格式，
#       CONFIG_XXX=n 是无效语法会导致整个文件被忽略！

# 关闭 mbedtls TLS（用 HTTP 裸 socket，不用 HTTPS）
# CONFIG_MBEDTLS_SSL_PROTO_DTLS is not set
# CONFIG_MBEDTLS_TLS_ENABLED is not set
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set
# CONFIG_MBEDTLS_HAVE_TIME is not set
# CONFIG_MBEDTLS_HAVE_TIME_DATE is not set
# CONFIG_MBEDTLS_X509_CRT_PARSE_C is not set
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_MBEDTLS_HARDWARE_GCM=y

# 最小化 lwip
# CONFIG_LWIP_IPV6 is not set
CONFIG_LWIP_MAX_SOCKETS=4
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_TCP_WND=4096
CONFIG_LWIP_TCP_SND_BUF=4096
CONFIG_LWIP_DHCP_MAX_NTP_SERVERS=0
CONFIG_LWIP_DNS_MAX_SERVERS=1
# CONFIG_LWIP_IRAM_OPTIMIZATION is not set
# CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION is not set
# CONFIG_LWIP_LOOPBACK_INTERFACE is not set
# CONFIG_LWIP_SNTP is not set
# CONFIG_LWIP_NETIF_API is not set
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_IP_REASS_MAX_PBUFS=1
# CONFIG_LWIP_FRAGMENT_TCP_MSS_OPTION is not set
# CONFIG_LWIP_IP_FRAG is not set
# CONFIG_LWIP_IP_REASSEMBLY is not set

# 最小化 WiFi
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_TX_BA_WIN=2
CONFIG_ESP_WIFI_RX_BA_WIN=2
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=2
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# CONFIG_ESP_WIFI_ENHANCED_LIGHT_SLEEP is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_CSI_ENABLED is not set
# CONFIG_ESP_WIFI_PSCAN_ENABLE is not set
CONFIG_ESP_WIFI_MBEDTLS_CRYPTO=y
# CONFIG_ESP_WIFI_MBEDTLS_TLS_CLIENT is not set

# 最小化 nvs_flash
# CONFIG_NVS_ENCRYPTION is not set
# CONFIG_NVS_COMPATIBLE_PRE_V4_3_ENABLE is not set

# 最小化 esp_netif
# CONFIG_ESP_NETIF_LOOPBACK is not set
# CONFIG_ESP_NETIF_BRIDGE_EN is not set

# 最小化其他
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2048