# ===== 裸机 Loader sdkconfig.defaults =====
# 目标：无 WiFi 版 app < 200KB

# ── 基础 ────────────────────────────────────────────────
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# ── Flash（保持与分区表一致） ───────────────────────────
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ── 体积优化（关键） ────────────────────────────────────
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# ── PSRAM（帧缓冲用） ───────────────────────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_OCCUPY_VSPI_HOST=y
CONFIG_SPIRAM_USE_MALLOC=y

# ── SD 卡（保留 sdspi，不用 VFS/fatfs） ─────────────────
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# ── 关闭不需要的 LVGL（裸机版完全不用） ────────────────
# 本项目不引入 lvgl 组件，无需相关配置。保留此注释说明。

# ── Bootloader GPIO factory reset（B 键 GPIO12 擦 otadata 回 loader） ──
CONFIG_BOOTLOADER_FACTORY_RESET=y
CONFIG_BOOTLOADER_NUM_PIN_FACTORY_RESET=12
CONFIG_BOOTLOADER_FACTORY_RESET_PIN_LOW=y
CONFIG_BOOTLOADER_OTA_DATA_ERASE=y
# Rollback disabled（与上游一致）
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is not set

# ── WiFi（默认关闭，开启时由 CI/用户追加 CONFIG_XIAOMIAO_ENABLE_WIFI=y） ──
# WiFi 凭据（SSID/PASS/HOST/PORT/PATH）从 SD 卡根目录 /wifi.conf 读取，
# 不再写死在固件中。参见 bm_wifi_ota.h 中的 bm_wifi_load_config()。